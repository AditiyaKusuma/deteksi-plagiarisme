# ============================================================================
#  Konfigurasi LLM/AI — Aplikasi Deteksi Plagiarisme (NIM 11241002)
#  Penyedia aktif: Google Gemini (gemini-2.0-flash).
#  Isi LLM_API_KEY dengan kunci API Gemini Anda, lalu jalankan: npm start
#  Penjelasan lengkap tiap variabel ada di .env.example
# ============================================================================

# Kunci API — HANYA dipakai di backend (server.js), tidak pernah dikirim ke
# frontend maupun ditulis ke log.
LLM_API_KEY=

# Penyedia: auto | openai | gemini  (auto menebak dari base URL / nama model)
LLM_PROVIDER=gemini

# Nama model, mis. gpt-4o-mini / gemini-2.0-flash / deepseek-chat
LLM_MODEL_NAME=gemini-2.0-flash

# Alamat REST API penyedia.
#   OpenAI : https://api.openai.com/v1
#   Gemini : https://generativelanguage.googleapis.com/v1beta
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Batas waktu satu panggilan API (milidetik) — maksimal 30000 (30 detik).
LLM_TIMEOUT_MS=30000

# Jumlah kata teks dokumen yang dikirim ke LLM — maksimal 8000.
LLM_MAX_KATA=8000

# Kreativitas keluaran (0 = paling konsisten dan patuh skema JSON).
LLM_TEMPERATURE=0.2

# JSON mode / structured output: auto | on | off
LLM_JSON_MODE=auto

# true = pakai data mock bila LLM gagal (khusus demo tanpa kunci API).
# false (bawaan) = kegagalan LLM dibalas HTTP 500 yang rapi.
LLM_FALLBACK_SIMULASI=false

PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
