# ============================================================================
#  Konfigurasi Aplikasi Deteksi Plagiarisme Proposal & Laporan Tugas Akhir
#  (NIM 11241002)
#
#  Cara pakai: salin berkas ini menjadi ".env" lalu isi nilainya.
#      Copy-Item .env.example .env
#
#  Berkas .env tidak pernah disajikan melalui HTTP (diblokir di server.js),
#  tidak boleh dibagikan, dan tidak boleh diunggah ke repositori publik.
#  API Key hanya dibaca oleh backend (server.js).
# ============================================================================

# ---- LLM / AI --------------------------------------------------------------
# Kunci API penyedia LLM (OpenAI / Gemini / penyedia kompatibel OpenAI).
# Bila dibiarkan kosong, analisis gagal dengan pesan yang rapi (HTTP 500),
# kecuali LLM_FALLBACK_SIMULASI=true.
LLM_API_KEY=

# Penyedia LLM:
#   auto   = tebak otomatis (Gemini bila base URL memuat "generativelanguage"
#            atau nama model diawali "gemini", selain itu OpenAI)
#   openai = POST {base}/chat/completions
#   gemini = POST {base}/models/{model}:generateContent
LLM_PROVIDER=gemini

# Nama model yang dipakai, mis.:
#   OpenAI  -> gpt-4o-mini / gpt-4o
#   Gemini  -> gemini-2.0-flash / gemini-1.5-pro
#   lain    -> deepseek-chat / llama-3.3-70b-versatile / qwen2.5:7b (Ollama)
LLM_MODEL_NAME=gemini-2.0-flash

# Alamat REST API penyedia (tanpa garis miring di akhir):
#   OpenAI       : https://api.openai.com/v1
#   Gemini       : https://generativelanguage.googleapis.com/v1beta
#   DeepSeek     : https://api.deepseek.com/v1
#   Groq         : https://api.groq.com/openai/v1
#   OpenRouter   : https://openrouter.ai/api/v1
#   Ollama lokal : http://localhost:11434/v1   (LLM_API_KEY boleh diisi "ollama")
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Batas waktu satu panggilan API LLM dalam milidetik.
# Dibulatkan otomatis ke rentang 1000-30000 (maksimal 30 detik).
LLM_TIMEOUT_MS=30000

# Jumlah kata teks dokumen yang dikirim ke LLM (menghemat token).
# Dibulatkan otomatis ke rentang 200-8000 (maksimal 8.000 kata pertama).
LLM_MAX_KATA=8000

# Tingkat kreativitas keluaran LLM. 0 = paling konsisten dan patuh skema JSON.
LLM_TEMPERATURE=0.2

# JSON mode / structured output:
#   auto = pakai JSON mode, dan mundur otomatis sekali bila penyedia menolaknya
#   on   = selalu pakai JSON mode
#   off  = jangan pakai JSON mode (andalkan prompt saja)
LLM_JSON_MODE=auto

# Penanganan kegagalan LLM (error API / timeout / JSON tidak sah):
#   false (BAWAAN) = kembalikan HTTP 500 dengan pesan yang rapi
#   true           = pakai data mock progress 30% (khusus demo tanpa kunci API)
LLM_FALLBACK_SIMULASI=false

# ---- Autentikasi -----------------------------------------------------------
# Kunci rahasia untuk menandatangani token sesi (HMAC-SHA256) pada endpoint
# /api/auth/login. Bila dibiarkan kosong, server membuat kunci acak setiap kali
# dijalankan sehingga semua sesi hangus saat server dijalankan ulang.
# Isi dengan teks acak panjang, mis. hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Masa berlaku token sesi dalam jam (1-168, bawaan 12).
AUTH_TTL_JAM=12

# ---- Server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Origin frontend yang diizinkan, pisahkan dengan koma. '*' untuk semua.
CORS_ORIGIN=*

# Lokasi penyimpanan hasil analisis + berkas unggahan.
# Kosongkan untuk memakai folder "data" di dalam proyek.
# DATA_DIR=D:/IPPL - Projek/data
